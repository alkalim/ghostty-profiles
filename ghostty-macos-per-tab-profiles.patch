@@ -0,0 +1,31 @@
+import Foundation
+import Testing
+@testable import Ghostty
+
+@MainActor
+struct ProfileDiscoveryTests {
+    @Test func discoversSortedProfilesAndRefreshes() throws {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        defer { try? FileManager.default.removeItem(at: directory) }
+
+        #expect(try AppDelegate.profileURLs(in: directory).isEmpty)
+        for name in ["red.ghostty", "blue.ghostty", "notes.txt", ".hidden.ghostty"] {
+            try "".write(to: directory.appendingPathComponent(name), atomically: true, encoding: .utf8)
+        }
+        try FileManager.default.createDirectory(
+            at: directory.appendingPathComponent("directory.ghostty"), withIntermediateDirectories: true)
+        #expect(try AppDelegate.profileURLs(in: directory).map(\.lastPathComponent) == ["blue.ghostty", "red.ghostty"])
+
+        try FileManager.default.removeItem(at: directory.appendingPathComponent("red.ghostty"))
+        try "".write(to: directory.appendingPathComponent("green.ghostty"), atomically: true, encoding: .utf8)
+        #expect(try AppDelegate.profileURLs(in: directory).map(\.lastPathComponent) == ["blue.ghostty", "green.ghostty"])
+    }
+
+    @Test func missingDirectory() {
+        let directory = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        #expect(throws: (any Error).self) {
+            try AppDelegate.profileURLs(in: directory)
+        }
+    }
+}
